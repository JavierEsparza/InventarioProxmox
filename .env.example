# Copiar este archivo como .env y completar los valores reales.
# Nunca subir .env al repositorio.

APP_NAME=InventarioProxmox
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
ASSET_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
PROXMOX_SYNC_LOG_LEVEL=info
PROXMOX_SYNC_LOG_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventario_proxmox
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=
DB_FOREIGN_KEYS=true

# Credenciales del flujo de auditoría SSH/Infransible.
INFRANSIBLE_USER=infransible
INFRANSIBLE_PASSWORD=

# Flujo de sincronización SSH heredado del inventario.
# NODE_SSH_PASS debe ser el valor cifrado que espera el controlador, no una contraseña plana.
NODE_SSH_USER=
NODE_SSH_PASS=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1
MEMCACHED_PORT=11211
MEMCACHED_USERNAME=
MEMCACHED_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sólo si se utiliza S3, DynamoDB, SQS o servicios AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
DYNAMODB_CACHE_TABLE=cache
DYNAMODB_ENDPOINT=
SQS_PREFIX=
SQS_QUEUE=default
SQS_SUFFIX=

# Sólo si se utilizan estos proveedores.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
POSTMARK_TOKEN=

# Broadcasting/Pusher opcional.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1
ABLY_KEY=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

BCRYPT_ROUNDS=12
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
